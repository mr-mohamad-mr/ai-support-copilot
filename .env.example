# AI Support Copilot — local environment (copy to .env, never commit it).
# COPILOT_SECRET signs the JWTs; set a long random value in production.
# The default in app/security.py is dev-only.
COPILOT_SECRET=change-me-to-a-long-random-secret
# Host port for the API when run under Docker Compose.
COPILOT_PORT=8000
