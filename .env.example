# AI Support Copilot — environment (copy to .env, never commit it).

# Signs the login tokens (JWT). Required: the app refuses to start with the
# built-in dev-only secret unless COPILOT_ENV=dev. Use a long random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
COPILOT_SECRET=change-me-to-a-long-random-secret
# production (default) or dev. Only dev allows the built-in secret.
COPILOT_ENV=production
# Host port for the API when run under Docker Compose.
COPILOT_PORT=8000

# Rate limits, as "<count>/<seconds>" (0/... disables one).
# COPILOT_LOGIN_RATE=10/300          # failed logins per client IP + username
# COPILOT_LOGIN_IP_RATE=50/300       # failed logins per client IP
# COPILOT_REGISTER_RATE=10/3600      # registrations per client IP
# COPILOT_WIDGET_CHAT_RATE=20/60     # widget questions per widget key + client IP
# COPILOT_WIDGET_CHAT_KEY_RATE=600/60  # widget questions per widget key
# Behind a reverse proxy you control, take the client IP from X-Forwarded-For.
# COPILOT_TRUST_PROXY=false

# Optional grounded LLM step (off when unset). OpenAI-compatible API.
# COPILOT_LLM_PROVIDER=ollama        # openai | openai-compatible | ollama | none
# COPILOT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# COPILOT_LLM_MODEL=llama3.2
# COPILOT_LLM_API_KEY=
# COPILOT_LLM_TIMEOUT=20
